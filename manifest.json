{
  "manifestVersion": 5,
  "id": "com.neria.bgmfinder",
  "name": "BGM Finder",
  "version": "0.1.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.1.0"
  },
  "requiredPermissions": {
    "localFileSystem": "request"
  },
  "entrypoints": [
    {
      "id": "bgmFinderPanel",
      "type": "panel",
      "label": {
        "default": "BGM Finder"
      },
      "minimumSize": {
        "width": 320,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 560
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 600
      }
    }
  ]
}
